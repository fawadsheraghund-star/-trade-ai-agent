# General
TELEGRAM_TOKEN=
BOT_OWNER_TELEGRAM_ID=         # numeric id to allow live confirmations by owner
USE_TESTNET=true               # true = paper trading by default
LIVE_ENABLE=false              # must be set true manually to allow real orders

# Exchange / CCXT
DEFAULT_EXCHANGE=binance
EXCHANGE_ID=binance            # or bybit, kucoin, gate, okx, etc
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_SUBACCOUNT=           # optional (e.g., for kucoin, okx)

# Position sizing / risk
POSITION_SIZE_PERCENT=1.0      # % of equity per trade (used if METHOD=fixed)
RISK_PERCENT=1.0               # % equity to risk per trade (used if METHOD=risk)
POSITION_SIZING_METHOD=fixed   # 'fixed' or 'risk'

# OpenAI for AI analysis (optional)
OPENAI_API_KEY=

# News / sentiment (optional)
NEWSAPI_KEY=

# Railway / deployment
RAILWAY_STATIC_ENV=production
